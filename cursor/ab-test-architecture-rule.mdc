actionToggleGridMode.test.tsx(new)
import { vi } from "vitest";
import { Excalidraw } from "../index";
import * as StaticScene from "../renderer/staticScene";
import { API } from "../tests/helpers/api";
import { render } from "../tests/test-utils";
import { actionToggleGridMode } from "./actionToggleGridMode";
const { h } = window;
describe("actionToggleGridMode", () => {
  it("toggles grid mode and re-renders the static canvas", async () => {
    const renderStaticScene = vi.spyOn(StaticScene, "renderStaticScene");
    await render(<Excalidraw />);
    renderStaticScene.mockClear();
    expect(h.state.gridModeEnabled).toBe(false);
    API.executeAction(actionToggleGridMode);
    expect(h.state.gridModeEnabled).toBe(true);
    expect(renderStaticScene).toHaveBeenCalledTimes(1);
    API.executeAction(actionToggleGridMode);
    expect(h.state.gridModeEnabled).toBe(false);
    expect(renderStaticScene).toHaveBeenCalledTimes(2);
  });
});


